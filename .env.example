# WIP source selection. Rebuild the image after changing this value.
AIRI_SOURCE_REF=feat/npc-transition-work

# Factorio headless version baked into the local image build.
FACTORIO_VERSION=latest

# Host-side persistent data directory and Factorio UDP port.
AIRI_DATA_DIR=./data
SERVER_PORT=34197
AIRI_STOP_GRACE_PERIOD=90s

# AIRI runtime configuration. These three provider values are required.
AIRI_ACTOR_MODE=npc
AIRI_CHAT_PLAYERS=
OPENAI_API_KEY=
OPENAI_API_BASEURL=
OPENAI_MODEL=
PROVIDER_TIMEOUT_MS=120000
MAX_PROVIDER_REQUESTS_PER_HOUR=300
SHUTDOWN_TIMEOUT_MS=60000
SAVE_NAME=

# Factorio.com public-listing credentials.
# Leave BOTH blank for a private/unlisted server.
FACTORIO_USERNAME=
FACTORIO_TOKEN=
